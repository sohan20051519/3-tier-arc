# Node.js Express REST API Environment Variables
PORT=5000
NODE_ENV=production

# PostgreSQL Database Connection
# In Docker / AWS deployment on Backend+DB EC2: DB_HOST=postgres
# In standalone local development without Docker: DB_HOST=localhost
DB_HOST=postgres
DB_PORT=5432
DB_NAME=taskmanager_db
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here
